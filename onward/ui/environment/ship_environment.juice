include ./ship_environment.fruit

Environment myEnvironment
{
	myEnvironmentMap onward/lightprobes/ui_ship.dds
	myEnvironmentMapIntensity .2
	myAmbientIntensity 1
	myAmbientPX 3.14009;2.61635;2.13898
	myAmbientNX 5.38857;4.71714;4.0048
	myAmbientPY 2.41323;2.84257;3.62534
	myAmbientNY 4.04738;2.83362;1.48102
	myAmbientPZ 3.75856;3.17406;2.57897
	myAmbientNZ 4.17405;3.46006;2.86426
	myLights
	{
		Light backLight
		{
			myPosition 50.0;5.0;-10
			myColor 1.0;1.0;1.0
			myIntensity 0
			mySourceRadius 100.0
			mySpecFactor 0.0
		}
		Light frontRight
		{
			myPosition 0.0;100.0;60
			myColor 1;1;1
			myIntensity 15
			mySourceRadius 500.0
			mySpecFactor 0.1
		}
		Light frontLeft
		{
			myPosition -50.0;5.0;-10
			myColor 1;1;1
			myIntensity 0
			mySourceRadius 100.0
			mySpecFactor 0.1
		}
	}
}

